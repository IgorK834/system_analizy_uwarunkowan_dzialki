<?xml version="1.0" encoding="UTF-8"?>
<!--
  Przycięty fragment realnej odpowiedzi GetCapabilities usługi KIUT,
  zweryfikowanej 2026-09-02. Usługa zwróciła dokument WMS 1.3.0 także przy
  negocjacji Capabilities z version=1.1.1; osobne GetMap z version=1.1.1
  zwróciło poprawny image/png. Zachowano opłaty, ograniczenia dostępu, CRS,
  nazwy warstw sieci i ograniczenia skalowe potrzebne testowi kontraktowemu.
-->
<WMS_Capabilities version="1.3.0" xmlns="http://www.opengis.net/wms">
  <Service>
    <Name>WMS</Name>
    <Title>Krajowa Integracja Uzbrojenia Terenu</Title>
    <Fees>Brak opłat / none</Fees>
    <AccessConstraints>NONE</AccessConstraints>
  </Service>
  <Capability>
    <Request>
      <GetMap><Format>image/png</Format></GetMap>
      <GetFeatureInfo><Format>text/html</Format><Format>text/xml</Format></GetFeatureInfo>
    </Request>
    <Layer>
      <Title>Krajowa Integracja Uzbrojenia Terenu</Title>
      <CRS>EPSG:2180</CRS>
      <CRS>EPSG:3857</CRS>
      <Layer queryable="1" cascaded="0">
        <Name>gesut</Name>
        <Title>Powiaty włączone do usługi</Title>
        <MinScaleDenominator>50000</MinScaleDenominator>
      </Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_urzadzenia</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_niezidentyfikowany</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_specjalny</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_telekomunikacyjny</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_cieplowniczy</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_gazowy</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_elektroenergetyczny</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_kanalizacyjny</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
      <Layer queryable="1" cascaded="1"><Name>przewod_wodociagowy</Name><MaxScaleDenominator>1000</MaxScaleDenominator></Layer>
    </Layer>
  </Capability>
</WMS_Capabilities>
