# Baza danych PostgreSQL / PostGIS (wartości developerskie)
POSTGRES_DB=dzialki
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Backend łączy się z bazą po hoście db w sieci Docker — nie używaj localhost
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/dzialki

# CORS — adresy frontendu dozwolone w developmentcie
BACKEND_CORS_ORIGINS=http://localhost:3000

# Adres API widoczny w przeglądarce użytkownika
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
